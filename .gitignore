# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Compatibility with Xcode 8 and earlier (Objective-C or Swift)
*.xcscmblueprint
*.xccheckout

## Compatibility with Xcode 3 and earlier (Objective-C)
*.mode1v3
*.mode2v3
*.perspectivev3
*.pbxuser
!default.pbxuser
*.ppubuild
*.suo
*.user
*.userdom
*.xcworkspacedata
*.xcscheme
!default.xcscheme
# Keep shared schemes so the demo can be opened and run consistently.
!newtypesdk_demo_ios.xcodeproj/xcshareddata/xcschemes/*.xcscheme
*.xcuserstate
*.xcuserschemeshare
*.profile
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Product builds
build/
DerivedData/
**/DerivedData/
**/build/

## CocoaPods
Pods/
*.xcworkspace
!default.xcworkspace
# App/demo projects should commit Podfile.lock for reproducible installs.
!Podfile.lock

## Carthage
Carthage/Build/

## Swift Package Manager
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved

## Build artifacts
*.o
*.a
# *.framework
dist/
artifacts/
artifacts-dynamic/
binary-artifacts/
manual-binary/

## SDK binary files
## Ignore generic xcframeworks, but keep the demo SDK binary vendored in libs/.
# *.xcframework
# !libs/NewTypeSDK.xcframework/
# !libs/NewTypeSDK.xcframework/**

## Logs
*.log

## macOS
.DS_Store
.AppleDouble
.LSOverride

## Temporary files
*.swp
*.swo
*~
*.tmp
